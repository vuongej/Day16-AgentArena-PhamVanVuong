# Mẫu cấu hình đường chạy thật. Copy thành `.env` rồi điền.
# File MẪU này an toàn để commit; `.env` thì KHÔNG (đã .gitignore).
#
#     cp .env.example .env
#
# Đường mock (mặc định, offline, vẫn tính điểm) KHÔNG cần file này.

ARENA_API_KEY=sk-...
ARENA_BASE_URL=https://<host>/v1
ARENA_MODEL=gpt-5.6-luna
